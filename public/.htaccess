Options -MultiViews

RewriteEngine On

# Permanent redirects for retired URLs, so old links and bookmarks keep working.
# Targets must be absolute URL paths: a relative target in an external redirect
# gets resolved against the filesystem root, leaking the server path into the URL.
# /docs/technical was merged into the white paper.
RewriteRule ^docs/technical/?$ /docs/whitepaper/ [R=301,L]

# Serve the exported Next.js 404 page with a proper 404 status.
# Use a relative path so it also works when deployed in a subdirectory.
ErrorDocument 404 404.html

# Serve existing files directly (assets, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map extensionless routes to exported /route/index.html without redirect.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
